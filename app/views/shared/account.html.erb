<div class="d-flex gap-2 align-items-center">
    <% if user_signed_in? %>
        <%= link_to current_user.name, user_path(current_user), class: "nav-link" %>
        <%= link_to t("nav.admin"), admin_users_path, class: "nav-link" if current_user.admin? %>
        <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: " btn btn-sm btn-outline-danger"%>

    <% else %>
    <%= link_to t("nav.sign_in"),new_user_session_path, class:"nav-link"%>
    
    <% end %>
</div>