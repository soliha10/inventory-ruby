<div class="vstack gap-2 mt-3">
    <%= resource_class.omniauth_providers.each do |provider| %>
    <%= button_to t("nav.continue_with", provider: OmniAuth::Utils.camelize(provider) ) omniauth_authorize_path(resource_name, provider), class: "btn btn-outline-secondary w-100", data: { turbo: false } %>
    <% end %>
    <%= link_to t("nav.sign_up"), new_registartion_path(resource_name) unless controller_name == "registrations"  %>
    <%= link_to t("nav.sign_in"), new_session_path(resource_name) unless controller_name == "sessions"  %>


</div>