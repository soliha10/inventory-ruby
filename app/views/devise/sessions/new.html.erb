<div class="mx-auto auth-card">
  <h1 class="h3 mb-3"> <%= t("nav.sign_in")%> </h1>
  <%= form_for resource, as: resource_name, url: session_path(resource_name), html: {class: "vstack gap-3"} do |form|%>
    <%= form.email_field :email, autofocus: true, class: "form-control" , placeholder: t("columns.email")%>
    <%= form.password_field :password, class: "form-control" , placeholder: t("columns.password")%>
    <%= form.submit t("nav.sign_in"), class: "btn btn-primary" %>

<%end%>
<%= render "devise/shared/links"%>
</div>